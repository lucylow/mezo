# ── Mezo Chain ────────────────────────────────────────────────────────────────
# Testnet RPC (public, no key needed)
MEZO_RPC_URL=https://rpc.test.mezo.org

# ── Contract Addresses (fill in after deployment) ─────────────────────────────
# Core vault
VITE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_VEMEZO_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GAUGE_CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MEZO_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MUSD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Governance (deployed with deploy-full.ts)
VITE_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GELATO_COMPOUNDER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Hardhat Deployment ────────────────────────────────────────────────────────
# Private key for deployment (never commit the real value)
PRIVATE_KEY=your_private_key_here

# Addresses passed to the deploy scripts
VEMEZO_ADDRESS=0x0000000000000000000000000000000000000000
GAUGE_CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000000
MEZO_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
MUSD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
TIGRIS_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
GELATO_AUTOMATE_ADDRESS=0x0000000000000000000000000000000000000000

# ── Keeper Bot ────────────────────────────────────────────────────────────────
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
KEEPER_PRIVATE_KEY=your_keeper_private_key_here
MAX_GAS_PRICE=100000000000
KEEPER_MARGIN_BPS=1100
# Set to "true" to receive Discord notifications for skipped rounds
KEEPER_VERBOSE_NOTIFICATIONS=false

# Treasury manager
TREASURY_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
MUSD_TOKEN=0x0000000000000000000000000000000000000000
# Minimum MUSD balance (in whole tokens) before treasury deployment is triggered
MUSD_MIN_DEPLOY_AMOUNT=1000
# MUSD Savings Vault address (for treasury auto-stake)
MUSD_SAVINGS_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
# TreasuryYieldManager address (set after deploy-musd.ts run)
YIELD_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Discord Notifications ─────────────────────────────────────────────────────
# Webhook for compound success messages
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Separate webhook for error alerts (falls back to DISCORD_WEBHOOK_URL if unset)
DISCORD_ALERT_URL=https://discord.com/api/webhooks/...

# ── Goldsky Subgraph ──────────────────────────────────────────────────────────
GOLDSKY_API_KEY=your_goldsky_api_key_here
# Deployed vault address (same as VAULT_ADDRESS, used in subgraph.yaml source.address)
SUBGRAPH_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
SUBGRAPH_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
SUBGRAPH_START_BLOCK=0
