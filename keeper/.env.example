# ── Network ──────────────────────────────────────────────────────────────────
# Mezo Testnet RPC (default if unset)
MEZO_RPC_URL=https://rpc.test.mezo.org

# ── Wallet ────────────────────────────────────────────────────────────────────
# Private key for the keeper EOA (never commit this!)
KEEPER_PRIVATE_KEY=

# ── Vault ─────────────────────────────────────────────────────────────────────
# Deployed VeMEZOAutoCompounder address
VAULT_ADDRESS=

# ── Gas limits ────────────────────────────────────────────────────────────────
# Maximum gas price in wei before the keeper aborts (default: 100 gwei)
MAX_GAS_PRICE=100000000000

# ── Profitability ─────────────────────────────────────────────────────────────
# Required reward/gas-cost ratio in basis points (default: 1100 = 110%)
KEEPER_MARGIN_BPS=1100

# ── Treasury ──────────────────────────────────────────────────────────────────
# Deployed TreasuryYieldManager contract address
TREASURY_MANAGER_ADDRESS=

# MUSD ERC-20 token address on Mezo
MUSD_TOKEN=

# Minimum idle MUSD balance (whole tokens) before deploying to savings vault
MUSD_MIN_DEPLOY_AMOUNT=1000

# ── Notifications (optional) ──────────────────────────────────────────────────
# Discord webhook for compound success notifications
DISCORD_WEBHOOK_URL=

# Discord webhook for error alerts (falls back to DISCORD_WEBHOOK_URL if unset)
DISCORD_ALERT_URL=

# Set to "true" to also send Discord messages for skipped/no-op rounds
KEEPER_VERBOSE_NOTIFICATIONS=false

# ── Monitoring ────────────────────────────────────────────────────────────────
# Goldsky subgraph URL for off-chain indexing
GOLDSKY_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_.../vemezo-auto-compounder/v1.0.0/gn
